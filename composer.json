{
    "name": "eyes360/voom-integration-sdk",
    "type": "library",
    "version": "0.0.1",
    "autoload": {
        "psr-4": {
            "Eyes360\\VoomIntegrationSdk\\": "src/",
            "Tests\\" : "tests/"
        }
    },
    "authors": [
        {
            "name": "Raghed Kahil",
            "email": "kahilraghed@gmail.com"
        }
    ],
    "require": {
        "php": ">=6.0",
        "guzzlehttp/guzzle": "^6.5",
        "ramsey/uuid": "^3.9"
    },
    "require-dev": {
        "pestphp/pest": "^4.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
